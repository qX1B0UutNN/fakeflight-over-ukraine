{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fakeflight.local/schemas/meta-v2.schema.json",
  "title": "FakeFlight rendering metadata version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_name",
    "rendered_at",
    "location",
    "source_ortho",
    "camera_config",
    "motion_config",
    "intrinsics",
    "trajectory",
    "frames"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "run_name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "rendered_at": {"type": "string", "format": "date-time"},
    "location": {"type": "string", "minLength": 1},
    "source_ortho": {"$ref": "#/$defs/source_ortho"},
    "camera_config": {
      "allOf": [
        {"$ref": "#/$defs/config_source"},
        {
          "properties": {
            "values": {
              "$ref": "https://fakeflight.local/schemas/camera-config-v1.schema.json"
            }
          }
        }
      ]
    },
    "motion_config": {
      "allOf": [
        {"$ref": "#/$defs/config_source"},
        {
          "properties": {
            "values": {
              "$ref": "https://fakeflight.local/schemas/motion-config-v1.schema.json"
            }
          }
        }
      ]
    },
    "intrinsics": {"$ref": "#/$defs/intrinsics"},
    "trajectory": {"$ref": "#/$defs/trajectory"},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/frame"}
    }
  },
  "$defs": {
    "source_ortho": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "crs"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "crs": {"type": "string", "minLength": 1}
      }
    },
    "config_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "values"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "values": {"type": "object"}
      }
    },
    "matrix3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {"type": "number"}
      }
    },
    "matrix4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {"type": "number"}
      }
    },
    "intrinsics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix", "image_width_px", "image_height_px"],
      "properties": {
        "matrix": {"$ref": "#/$defs/matrix3"},
        "image_width_px": {"type": "integer", "minimum": 1},
        "image_height_px": {"type": "integer", "minimum": 1}
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "file": {"type": "string", "minLength": 1},
        "source_feature": {"$ref": "#/$defs/source_feature"}
      }
    },
    "source_feature": {
      "type": "object",
      "required": ["type", "properties", "geometry"],
      "properties": {
        "type": {"const": "Feature"},
        "properties": {"type": ["object", "null"]},
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": {"enum": ["LineString", "MultiLineString"]},
            "coordinates": {"type": "array", "minItems": 1}
          }
        }
      }
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yaw", "pitch", "roll"],
      "properties": {
        "yaw": {"type": "number"},
        "pitch": {"type": "number"},
        "roll": {"type": "number"}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_index",
        "timestamp_sec",
        "distance_m",
        "position_world",
        "heading_deg",
        "orientation_deg",
        "extrinsic_world_to_camera",
        "image_path"
      ],
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0},
        "timestamp_sec": {"type": "number", "minimum": 0},
        "distance_m": {"type": "number", "minimum": 0},
        "position_world": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        },
        "heading_deg": {"type": "number"},
        "orientation_deg": {"$ref": "#/$defs/orientation"},
        "extrinsic_world_to_camera": {"$ref": "#/$defs/matrix4"},
        "image_path": {"type": "string", "minLength": 1}
      }
    }
  }
}
